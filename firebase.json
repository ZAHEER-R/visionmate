{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": ".",
    "predeploy": ["node scripts/build-config.mjs"],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/.env",
      "supabase/**",
      "functions/**",
      "scripts/**",
      "megathon_access_*.json",
      "*.zip"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}

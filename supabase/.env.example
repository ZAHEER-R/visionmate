# Copy to supabase/.env, fill these private values, then run:
# supabase secrets set --env-file supabase/.env
# Keep supabase/.env out of Git. Never paste these into browser config.
ANUVAADHUB_ACCESS_TOKEN_EN=
ANUVAADHUB_ACCESS_TOKEN_HI=
ANUVAADHUB_ACCESS_TOKEN_TA=
ANUVAADHUB_ACCESS_TOKEN_TE=
ANUVAADHUB_ACCESS_TOKEN_KN=
ANUVAADHUB_ACCESS_TOKEN_ML=
ANUVAADHUB_ACCESS_TOKEN_PA=

# Optional compatibility fallback if the provider uses one shared token.
# ANUVAADHUB_ACCESS_TOKEN=

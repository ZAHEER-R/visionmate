# Public Supabase configuration is used by cloud AI. Firebase values are optional
# and are only needed for Google/email account sign-in and account data sync.
SUPABASE_URL=https://bwxvnkutnjagqsivuqbz.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Optional Firebase Web App configuration.
FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com
GOOGLE_OAUTH_CLIENT_ID=YOUR_FIREBASE_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Store private provider credentials with `supabase secrets set`, not here.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=
